<%@ page isErrorPage="true" contentType="text/html; charset=UTF-8" %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Page Not Found</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f7f7f7;
      color: #333;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
    }
    .card {
      text-align: center;
      background: #fff;
      padding: 2em 3em;
      border-radius: 8px;
      box-shadow: 0 4px 14px rgba(0,0,0,0.08);
    }
    h1 {
      font-size: 2em;
      margin-bottom: 0.3em;
      color: #c0392b;
    }
    p {
      margin: 0.5em 0 1.5em;
    }
    a {
      color: #2980b9;
      text-decoration: none;
      font-weight: bold;
    }
    a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <div class="card">
    <h1>404 - Page Not Found</h1>
    <p>Sorry, the page you are looking for does not exist.</p>
  </div>
</body>
</html>
